---
layout: default
title: About
leaflet: true
---
<section class="intro">
  <h1>{{ site.author.name }}</h1>
  <p class="role">{{ site.author.tagline }}</p>
  <p class="bio">{{ site.author.intro }}</p>
  <p class="links">
    <a href="mailto:{{ site.author.email }}">Email</a>
    <a href="{{ site.author.linkedin }}">LinkedIn</a>
    <a href="{{ site.author.github }}">GitHub</a>
    <a href="{{ '/cv/' | relative_url }}">CV</a>
  </p>
</section>

<section class="sec" id="education">
  <h2>Education</h2>
  <div class="entries">
  {% for e in site.data.education %}
    <div class="entry">
      <div class="entry-when">{{ e.period }}</div>
      <div>
        <h3>{{ e.school }}</h3>
        <p class="entry-sub">{{ e.degree }}{% if e.note %} · {{ e.note }}{% endif %}</p>
        {% if e.courses %}<details><summary>Coursework</summary><p>{{ e.courses }}</p></details>{% endif %}
      </div>
    </div>
  {% endfor %}
  </div>
</section>

<section class="sec" id="projects">
  <div class="sec-head">
    <h2>Projects</h2>
    <p>Each project is pinned where the work happened. Filter by area or skill, or open one to read more and try its demo.</p>
  </div>
  {% include explorer.html %}
</section>

<section class="sec" id="experience">
  <h2>Experience</h2>
  <div class="entries">
  {% for x in site.data.experience %}
    <div class="entry">
      <div class="entry-when">{{ x.period }}</div>
      <div>
        <h3>{{ x.role }}</h3>
        <p class="entry-sub">{{ x.org }} · {{ x.place }}</p>
        {% if x.projects %}<p class="entry-links">{% for s in x.projects %}{% assign u = '/projects/' | append: s | append: '/' %}{% assign pr = site.projects | where: "url", u | first %}{% if pr %}<a href="{{ pr.url | relative_url }}">{{ pr.title }}</a>{% endif %}{% endfor %}</p>{% endif %}
      </div>
    </div>
  {% endfor %}
  </div>
</section>

<section class="sec" id="toolbox">
  <h2>Toolbox</h2>
  <dl class="toolbox">
  {% for t in site.data.toolbox %}<dt>{{ t.group }}</dt><dd>{{ t.items }}</dd>{% endfor %}
  </dl>
</section>
